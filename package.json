{
  "name": "vurqel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Temporal supply-chain exposure proof: proves which historical builds resolved a compromised package during its live window, down to the commit, frozen-lockfile CI job, and production-labelled service build, with a source-linked receipt backed by a HydraDB graph path.",
  "keywords": [
    "supply-chain",
    "security",
    "provenance",
    "hydradb",
    "graph",
    "sbom",
    "incident-response"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mystiquemide/VURQEL.git"
  },
  "homepage": "https://github.com/mystiquemide/VURQEL#readme",
  "bugs": {
    "url": "https://github.com/mystiquemide/VURQEL/issues"
  },
  "author": "MystiqueMide",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "investigate": "node --import tsx src/cli.ts investigate",
    "hydradb:up": "bash scripts/hydradb-up.sh",
    "hydradb:down": "bash scripts/hydradb-down.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
