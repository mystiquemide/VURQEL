# Vurqel local configuration example. Copy to .env and adjust.
# NOTE: the token below is the documented HydraDB *local development* token
# (see scripts/hydradb-up.sh). It is NOT a secret and must never be reused
# for a deployed/TLS node.

# HydraDB client transport (resolved in CP-001 / DEC-002: HTTP JSON API)
HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_ADMIN_URL=http://127.0.0.1:9090
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL=cell-0

# Pinned runtime (DEC-007). scripts/hydradb-up.sh runs this exact digest.
HYDRADB_IMAGE=ghcr.io/hydra-db/hydradb@sha256:db78309a233be54662db29744047e985a39b51c45a270d1a1f47c31a62cdb709

# GitHub source adapters (Phase 2). All optional.
# GITHUB_TOKEN: a fine-grained/classic PAT lifts the 60/hr anonymous limit to
# 5000/hr. It is a real secret — set it in .env (git-ignored), never commit it.
# GITHUB_TOKEN=
# Cache mode for GitHub responses: readwrite (default) | readonly (offline) | refresh (always fetch).
VURQEL_GH_CACHE=readwrite
